# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

PROJECT_NAME=MLPlayground
STACK_NAME=mlplayground

DOMAIN=localhost
ENVIRONMENT=local

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=mlplayground
POSTGRES_USER=mluser
POSTGRES_PASSWORD=changethis

SECRET_KEY=changethis

FIRST_SUPERUSER=admin@mlplayground.local
FIRST_SUPERUSER_PASSWORD=changethis

BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000
FRONTEND_HOST=http://localhost:5173

# USDA NASS QuickStats API key — https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# NOAA Climate Data Online API token — https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=

DOCKER_IMAGE_BACKEND=mlplayground-backend
DOCKER_IMAGE_FRONTEND=mlplayground-frontend
